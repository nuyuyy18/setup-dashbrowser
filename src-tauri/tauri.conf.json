{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "DashBrowser",
  "version": "2.0.0",
  "identifier": "com.dashbrowser.app",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://127.0.0.1:8200"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DashBrowser Desktop",
        "width": 1300,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
